# ============================================================
# POLYMARKET HFT BOT v2 — Spread Arbitrage
# Estrategia: compra YES + NO cuando suman < 1.00 (profit garantizado)
# ============================================================

# --- MODO ---
# paper = simulación sin dinero (por defecto)
# live  = trading real
BOT_MODE=paper

# --- POLYMARKET API (solo para modo live) ---
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_PRIVATE_KEY=
POLY_CHAIN_ID=137

# --- CAPITAL ---
INITIAL_CAPITAL=1000.0

# Máximo por operación (% del capital)
MAX_BET_PCT=0.05

# --- UMBRALES SPREAD ARBITRAGE ---
# Spread neto mínimo DESPUÉS de fees (2% por lado = 4% total)
# Ejemplo: spread bruto 8% - fees 4% = 4% neto → poner MIN_EDGE=0.04
MIN_EDGE=0.04

# EV mínimo por USDC invertido
MIN_EXPECTED_VALUE=0.03

# Probabilidad mínima de ganar (en arbi = siempre 1.0, no relevante)
MIN_WIN_PROBABILITY=0.55

# Kelly fraccionado
KELLY_FRACTION=0.25

# Máximo de posiciones simultáneas
MAX_OPEN_POSITIONS=10

# Intervalo ciclo en ms
CYCLE_INTERVAL_MS=300

# --- FILTROS DE MERCADO ---
# Liquidez mínima en USDC
MIN_MARKET_LIQUIDITY=200

# Horas mínimas hasta resolución
MIN_HOURS_TO_EXPIRY=1

# Horas máximas hasta resolución (17520 = 2 años)
MAX_HOURS_TO_EXPIRY=17520

# Categorías (no usado en v2, todos los mercados se analizan)
TARGET_CATEGORIES=all

# --- APIs PRECIO (para análisis secundario) ---
ALPHA_VANTAGE_KEY=
BINANCE_TESTNET=false
