# ============================================================
# POLYMARKET HFT BOT - Configuración
# Copia este archivo como .env y completa los valores
# ============================================================

# --- MODO DE OPERACIÓN ---
# paper  = simulación sin dinero real (por defecto, RECOMENDADO para empezar)
# live   = trading real con USDC en Polygon
BOT_MODE=paper

# --- POLYMARKET CLOB API ---
# Obtener en: https://polymarket.com (perfil → API Keys)
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Wallet Polygon para firmar transacciones (solo live)
POLY_PRIVATE_KEY=
POLY_CHAIN_ID=137

# --- PARÁMETROS DE TRADING ---
# Capital inicial disponible (USDC)
INITIAL_CAPITAL=1000.0

# Tamaño máximo de apuesta por operación (% del capital)
MAX_BET_PCT=0.05

# Edge mínimo requerido (diferencia entre prob real vs mercado)
MIN_EDGE=0.03

# Probabilidad mínima de ganar para entrar
MIN_WIN_PROBABILITY=0.60

# EV mínimo esperado (expected value mínimo)
MIN_EXPECTED_VALUE=0.02

# Máximo de posiciones abiertas simultáneas
MAX_OPEN_POSITIONS=8

# Multiplicador Kelly (0.25 = Kelly fraccionado conservador)
KELLY_FRACTION=0.25

# Intervalo del ciclo principal en milisegundos
CYCLE_INTERVAL_MS=200

# --- APIs DE PRECIOS ---
# Alpha Vantage (oro/commodities) - gratis en alphavantage.co
ALPHA_VANTAGE_KEY=

# Binance (cripto) - no requiere clave para datos públicos
BINANCE_TESTNET=false

# --- FILTROS DE MERCADO ---
# Categorías a operar: crypto,commodities (separadas por coma)
TARGET_CATEGORIES=crypto,commodities

# Liquidez mínima en el mercado (USDC)
MIN_MARKET_LIQUIDITY=500

# Horas mínimas hasta resolución del mercado
MIN_HOURS_TO_EXPIRY=1

# Horas máximas hasta resolución
# Los mercados de cripto en Polymarket expiran en meses/años
# 17520 = 2 años | 8760 = 1 año | 2160 = 3 meses
MAX_HOURS_TO_EXPIRY=17520

# --- ESTRATEGIA RAPIDA: mercados Up/Down de 5m y 15m ---
ENABLE_FAST=true
# Solo BTC y ETH estan validados en backtest (SOL/XRP existen pero sin validar)
FAST_ASSETS=BTC,ETH
FAST_TIMEFRAMES=5m,15m
# Edge neto minimo (despues de comision) para entrar
FAST_MIN_EDGE=0.05
# Multiplicador de volatilidad del modelo (2.0 = calibrado en backtest fuera de muestra)
FAST_SIGMA_MULT=2.0

# Mercados largos (vencen en meses; bloquean capital; sin validar). Desactivado.
ENABLE_LONG_MARKETS=false
