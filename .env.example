# ============================================================
# POLYMARKET HFT BOT - Configuración
# Copia este archivo como .env y completa los valores
# ============================================================

# --- MODO DE OPERACIÓN ---
# paper  = simulación sin dinero real (por defecto, RECOMENDADO para empezar)
# live   = trading real con USDC en Polygon
BOT_MODE=paper

# --- POLYMARKET CLOB API ---
# Obtener en: https://polymarket.com (perfil → API Keys)
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Wallet Polygon para firmar transacciones (solo live)
POLY_PRIVATE_KEY=
POLY_CHAIN_ID=137

# --- PARÁMETROS DE TRADING ---
# Capital inicial disponible (USDC)
INITIAL_CAPITAL=1000.0

# Tamaño máximo de apuesta por operación (% del capital)
MAX_BET_PCT=0.05

# Edge mínimo requerido (diferencia entre prob real vs mercado)
MIN_EDGE=0.03

# Probabilidad mínima de ganar para entrar
MIN_WIN_PROBABILITY=0.60

# EV mínimo esperado (expected value mínimo)
MIN_EXPECTED_VALUE=0.02

# Máximo de posiciones abiertas simultáneas
MAX_OPEN_POSITIONS=8

# Multiplicador Kelly (0.25 = Kelly fraccionado conservador)
KELLY_FRACTION=0.25

# Intervalo del ciclo principal en milisegundos
CYCLE_INTERVAL_MS=200

# --- APIs DE PRECIOS ---
# Alpha Vantage (oro/commodities) - gratis en alphavantage.co
ALPHA_VANTAGE_KEY=

# Binance (cripto) - no requiere clave para datos públicos
BINANCE_TESTNET=false

# --- FILTROS DE MERCADO ---
# Categorías a operar: crypto,commodities (separadas por coma)
TARGET_CATEGORIES=crypto,commodities

# Liquidez mínima en el mercado (USDC)
MIN_MARKET_LIQUIDITY=500

# Horas mínimas hasta resolución del mercado
MIN_HOURS_TO_EXPIRY=1

# Horas máximas hasta resolución
# Los mercados de cripto en Polymarket expiran en meses/años
# 17520 = 2 años | 8760 = 1 año | 2160 = 3 meses
MAX_HOURS_TO_EXPIRY=17520

# --- ESTRATEGIA RAPIDA: mercados Up/Down de 5m y 15m ---
ENABLE_FAST=true
# Se SIGUEN todos y se registran en el diario (logs/calibration.csv); solo se OPERAN los validados en backtest.
# HYPE y las ventanas de 4h no tienen evidencia suficiente: usa `python calibration.py` para decidir cuando operarlos.
FAST_ASSETS=BTC,ETH,SOL,XRP,DOGE,BNB,HYPE
FAST_TIMEFRAMES=5m,15m,4h
FAST_TRADE_ASSETS=BTC,ETH,SOL,XRP,DOGE,BNB
FAST_TRADE_TIMEFRAMES=5m,15m
# Tope conjunto (posiciones + ordenes en vuelo) como % del capital: los activos cripto se mueven a la vez
MAX_EXPOSURE_PCT=0.25
# Edge neto minimo (despues de comision) para entrar
FAST_MIN_EDGE=0.08
# Volatilidad del modelo y ruido de base Binance/Chainlink (elegidos en entrenamiento, comprobados en prueba)
FAST_SIGMA_MULT=1.0
FAST_BASIS=0.0001
# Websockets en tiempo real (si fallan, cae solo a REST)
FAST_USE_WS=true
# Diario de calibracion (predicciones y resultados reales)
FAST_JOURNAL=true
# Solo operar ventanas cuya referencia de Chainlink se vio en directo (evita falsos edges cerca del precio a batir)
FAST_REQUIRE_EXACT_REF=true
# Separacion minima entre ciclos (el bucle se despierta con cada dato). 1 ms = mas reaccion y mas CPU
REACT_MIN_INTERVAL_MS=1

# --- SIMULACION REALISTA (paper) ---
# La orden tarda esto en llegar al libro y solo se llena si el ask no se aleja mas de PAPER_MAX_SLIPPAGE
PAPER_FILL_LATENCY_MS=150
PAPER_MAX_SLIPPAGE=0.01

# --- RECOGIDA DE BENEFICIOS (teclas en vivo: C cobrar cesta, X cerrar todo, P pausar, A auto on/off) ---
AUTO_COLLECT=true
# Vende una posicion al ganar este % neto (cobrar antes rinde menos pero acierta mas; ver README)
LOCK_PROFIT_PCT=0.30
# Cobra toda la cesta en positivo al sumar este % del capital (0 = desactivado; sin backtestear)
BASKET_TARGET_PCT=0.03

# Mercados largos (vencen en meses; bloquean capital; sin validar). Desactivado.
ENABLE_LONG_MARKETS=false
